# Provider: openai (default) or anthropic. Unset picks anthropic only when just
# ANTHROPIC_API_KEY is present.
# PROVIDER=openai

# OpenAI-compatible endpoint (chat completions by default; OPENAI_API=openai-responses
# switches to the Responses API).
OPENAI_API_KEY=sk-your-api-key
OPENAI_BASE_URL=https://your-host/v1
# OPENAI_API=openai-completions
# OPENAI_THINKING_FORMAT=openai   # detected from the host: deepseek, zai, together, openrouter

# Anthropic Messages endpoint (/v1 is appended when missing).
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# ANTHROPIC_THINKING_MODE=budget  # or adaptive

# Model and default thinking level (off, minimal, low, medium, high, xhigh, max).
MODEL=deepseek-chat
REASONING_EFFORT=high

# Optional transport limits, per provider prefix.
# OPENAI_TIMEOUT_SECONDS=60
# OPENAI_MAX_RETRIES=2
# OPENAI_MAX_RETRY_DELAY_SECONDS=1.0

# Optional model metadata for endpoints that do not report it.
# MODEL_CONTEXT_WINDOW=200000
# MODEL_MAX_TOKENS=16384
# MODEL_SUPPORTS_IMAGES=false

# Memory extension (built-in "memory"; --no-extensions disables it).
# USER.md / MEMORY.md limits, target switches, write approval and queue timeouts.
# HERMES_MEMORY_CHAR_LIMIT=2200
# HERMES_MEMORY_USER_CHAR_LIMIT=1375
# HERMES_MEMORY_ENABLED=true
# HERMES_MEMORY_USER_PROFILE_ENABLED=true
# HERMES_MEMORY_WRITE_APPROVAL=false
# HERMES_MEMORY_PREFETCH_TIMEOUT=8.0
# HERMES_MEMORY_DRAIN_TIMEOUT=5.0

# Experience extension: verifier-gated Skill evolution only.
# Formal Skill writes are verifier-gated; candidate content scanning defaults on.
# EXPERIENCE_SKILLS_WRITE_APPROVAL=false
# EXPERIENCE_SKILL_GUARD=true
# EXPERIENCE_SKILL_LEDGER=true
# EXPERIENCE_EVOLUTION_SUITE=evolution
# EXPERIENCE_EVOLUTION_SUITE_VERSION=2
# EXPERIENCE_EVOLUTION_BUDGET_SECONDS=300

# Curator extension (built-in "curator"): cadence-gated Skill-library maintenance.
# It marks idle Skills stale, archives unprotected evolution-owned Skills into
# <skills-root>/.archive/ (never deletes), snapshots each Skill root before a pass,
# and turns its bounded review into cold candidates; content changes still need /evolve.
# CURATOR_ENABLED=true
# CURATOR_INTERVAL_HOURS=168
# CURATOR_STALE_AFTER_DAYS=30
# CURATOR_ARCHIVE_AFTER_DAYS=90
# CURATOR_BACKUP_KEEP=5
# CURATOR_LLM_REVIEW_ENABLED=true

# Four-layer compaction extension (built-in "compaction"): it rewrites requests only
# while compaction.strategy = "four-layer" in ~/.run/settings.json. Representative
# switches (all default to the Claude Code reference constants):
# COMPACTION_FOUR_LAYER_ENABLED=true
# COMPACTION_FOUR_LAYER_L4_ENABLED=true
# COMPACTION_FOUR_LAYER_CONTEXT_WINDOW=128000
# COMPACTION_FOUR_LAYER_KEEP_RECENT_TOKENS=20000
# COMPACTION_FOUR_LAYER_SNIP_NUDGE_THRESHOLD=30

# All seven built-in extensions load by default. Plan mode starts off.
# Permission modes: review (default), yolo/autonomous, strict. Same as my-pi-agent.
# RUN_AGENT_PERMISSION_MODE=review
# MCP: put <cwd>/.mcp.json with mcpServers (stdio command/args/env), same as my-pi-agent.
# {"mcpServers":{"context7":{"command":"npx","args":["-y","@upstash/context7-mcp"]}}}
