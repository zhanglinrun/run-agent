# Provider: openai (default) or anthropic. Unset picks anthropic only when just
# ANTHROPIC_API_KEY is present.
# PROVIDER=openai

# OpenAI-compatible endpoint (chat completions by default; OPENAI_API=openai-responses
# switches to the Responses API).
OPENAI_API_KEY=sk-your-api-key
OPENAI_BASE_URL=https://your-host/v1
# OPENAI_API=openai-completions
# OPENAI_THINKING_FORMAT=openai   # detected from the host: deepseek, zai, together, openrouter

# Anthropic Messages endpoint (/v1 is appended when missing).
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# ANTHROPIC_THINKING_MODE=budget  # or adaptive

# Model and default thinking level (off, minimal, low, medium, high, xhigh, max).
MODEL=deepseek-chat
REASONING_EFFORT=high

# Optional transport limits, per provider prefix.
# OPENAI_TIMEOUT_SECONDS=60
# OPENAI_MAX_RETRIES=2
# OPENAI_MAX_RETRY_DELAY_SECONDS=1.0

# Optional model metadata for endpoints that do not report it.
# MODEL_CONTEXT_WINDOW=200000
# MODEL_MAX_TOKENS=16384
# MODEL_SUPPORTS_IMAGES=false

# Feishu gateway (run gateway). Grant im:message.p2p_msg:readonly,
# im:message.group_at_msg:readonly and im:message:send_as_bot, enable the long
# connection and subscribe to im.message.receive_v1.
FEISHU_APP_ID=cli_your-app-id
FEISHU_APP_SECRET=your-app-secret
# FEISHU_DOMAIN=https://open.larksuite.com
# FEISHU_ALLOWED_USERS=ou_your-open-id,ou_another-open-id
# FEISHU_ALLOW_ALL_USERS=false
# FEISHU_REQUIRE_MENTION=true
# FEISHU_REPLY_TO_MODE=first
# GATEWAY_SESSION_RESET_MODE=none   # idle, daily or both
# GATEWAY_SESSION_RESET_IDLE_MINUTES=1440
# GATEWAY_SESSION_RESET_AT_HOUR=4
# GATEWAY_GROUP_SESSIONS_PER_USER=true
# GATEWAY_AGENT_IDLE_SECONDS=1800
# GATEWAY_BUSY_INPUT_MODE=interrupt   # queue or steer
# GATEWAY_BUSY_QUEUE_MAX_PENDING=32
# GATEWAY_TURN_LEASE_TIMEOUT_SECONDS=1800
# GATEWAY_STALL_SECONDS=300            # notice only; does not cancel the task
# GATEWAY_HEARTBEAT_POLL_SECONDS=5
# GATEWAY_DELIVERY_LEDGER=true

# Experience extension (enabled by default; --no-extensions disables it): all optional.
# Review generation is independent of the main task's REASONING_EFFORT.
# EXPERIENCE_REVIEW_THINKING=off
# EXPERIENCE_REVIEW_MAX_OUTPUT_TOKENS=1600
# EXPERIENCE_REVIEW_ENABLED=true
# EXPERIENCE_MEMORY_NUDGE_INTERVAL=10  # user inputs; REVIEW_EVERY_TURNS is a legacy alias
# EXPERIENCE_SKILL_NUDGE_INTERVAL=10   # model rounds (turn_start)
# EXPERIENCE_REVIEW_ON_SIGNALS=false   # admit on failure/correction; cadence-only by default
# EXPERIENCE_REVIEW_MAX_ITERATIONS=16
# EXPERIENCE_REVIEW_MAX_INPUT_TOKENS=600000
# EXPERIENCE_SKILL_GUARD=false          # optional content scan; ownership guards still apply
# EXPERIENCE_REVIEW_COOLDOWN_SECONDS=0
# EXPERIENCE_REVIEW_NOTIFY=on           # off, on or verbose
# EXPERIENCE_CURATOR_INTERVAL_HOURS=168
# EXPERIENCE_CURATOR_STALE_DAYS=30
# EXPERIENCE_CURATOR_ARCHIVE_DAYS=90
# EXPERIENCE_CURATOR_CONSOLIDATE=false
# EXPERIENCE_MEMORY_CHAR_LIMIT=2200
# EXPERIENCE_USER_CHAR_LIMIT=1375

# All four built-in extensions load by default. Plan mode starts off.
# Permission modes: review (default), yolo/autonomous, strict. Same as my-pi-agent.
# RUN_AGENT_PERMISSION_MODE=review
# MCP: put <cwd>/.mcp.json with mcpServers (stdio command/args/env), same as my-pi-agent.
# {"mcpServers":{"context7":{"command":"npx","args":["-y","@upstash/context7-mcp"]}}}
