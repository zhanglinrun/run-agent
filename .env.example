# OpenAI-compatible (default if OPENAI_BASE_URL does not contain /anthropic)
OPENAI_API_KEY=sk-your-api-key
OPENAI_BASE_URL=https://your-host/v1
MODEL=deepseek-chat
REASONING_EFFORT=high

# Feishu Gateway (examples/gateway_extensions/feishu.py)
FEISHU_APP_ID=cli_your-app-id
FEISHU_APP_SECRET=your-app-secret
# FEISHU_DOMAIN=https://open.larksuite.com

# Mem0 extension (loaded with -e extensions/mem0 or installed explicitly)
MEM0_API_KEY=m0-your-api-key
MEM0_USER_ID=run-agent-user
MEM0_APP_ID=run-agent
# MEM0_BASE_URL=https://api.mem0.ai
# MEM0_TIMEOUT_SECONDS=30
# MEM0_ORG_ID=
# MEM0_PROJECT_ID=

# Optional policy and MCP extensions
# RUN_AGENT_PERMISSION_MODE=guarded
# RUN_AGENT_MCP_SERVERS={"internal":"https://mcp.example.com/mcp"}
# 模型角色建议显式分开配置；MODEL_SMOKE 填当前网关提供的 DeepSeek Flash 精确 ID。
# MODEL_SMOKE=<exact-deepseek-flash-model-id>
# MODEL_PRIMARY=gpt-5.5
# 正式 pilot 通过命令行 --model 或 MODEL_PRIMARY 选择；不要把两个模型混入同一组消融。

# Generic aliases (same as APIKEY / API)
# APIKEY=sk-your-api-key
# API=https://your-host/v1

# Anthropic-compatible (used when ANTHROPIC_* is set, or base URL path contains /anthropic)
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_BASE_URL=https://your-host/anthropic
